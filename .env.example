# Entorno
ENVIRONMENT=development

# Seguridad y JWT
SECRET_KEY=cambiar_por_un_token_criptografico_seguro_min_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Credenciales de Base de Datos (PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=una_contrasena_segura_de_produccion
POSTGRES_DB=mtg_market
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL calculada de base de datos
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Scryfall API Headers (Fan Content Policy)
SCRYFALL_USER_AGENT=MTGCardMarketApp/1.0
SCRYFALL_ACCEPT_HEADER=application/json;q=0.9,*/*;q=0.8